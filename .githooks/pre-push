#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "[pre-push] running full test suite..."
go test ./...

if [[ -d "./integration" ]]; then
  echo "[pre-push] running integration tests explicitly..."
  go test ./integration/...
fi

echo "[pre-push] OK"
